\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Top/edge ratio of contact resistance $R_c$ (squares) and total resistance $R_{\rm  tot}$ (circles) against the top-contact vdW transmission, for $\mu _\perp /\mu _\parallel =0.01$ (solid) and 1 (dashed). The dotted line marks the baseline $\mathcal  {T}_{\rm  vdW}=0.013$, the dashed vertical line the value $\mathcal  {T}_{\rm  vdW}=1$ at which the Au/MoS$_2$ fit saturates, and the shaded band the range sampled by the Monte Carlo analysis ($8\times 10^{-4}$ to 0.13). The horizontal line marks equal resistance. (a, b) Gated on state, $V_G=-3$~V; (c) ungated. $V_D=0.05$~V, $L_c=50$~nm.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:vdw}{{7}{11}{Top/edge ratio of contact resistance $R_c$ (squares) and total resistance $R_{\rm tot}$ (circles) against the top-contact vdW transmission, for $\mu _\perp /\mu _\parallel =0.01$ (solid) and 1 (dashed). The dotted line marks the baseline $\mathcal {T}_{\rm vdW}=0.013$, the dashed vertical line the value $\mathcal {T}_{\rm vdW}=1$ at which the Au/MoS$_2$ fit saturates, and the shaded band the range sampled by the Monte Carlo analysis ($8\times 10^{-4}$ to 0.13). The horizontal line marks equal resistance. (a, b) Gated on state, $V_G=-3$~V; (c) ungated. $V_D=0.05$~V, $L_c=50$~nm}{figure.7}{}}
